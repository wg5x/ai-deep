# AI Life service environment

# Runtime mode: manual | assisted | autonomous
AI_LIFE_RUNTIME_MODE=manual

# Locale
AI_LIFE_DEFAULT_LANGUAGE=zh-CN
AI_LIFE_DEFAULT_REGION=CN-BJ

# Web/API ports
WEB_PORT=3000
API_PORT=3001

# Storage
DATA_DIR=./data
SQLITE_PATH=./data/ai-life.sqlite

# LLM provider placeholder
LLM_PROVIDER=openai
OPENAI_API_KEY=

# Notifications
NOTIFICATION_PRIMARY_CHANNEL=manual
NOTIFICATION_SEND_ENABLED=false

# Feishu approval bridge
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APPROVAL_CHAT_ID=
FEISHU_CALLBACK_PORT=3002
APPROVALS_DIR=./data/approvals

# Safety
REQUIRE_HUMAN_APPROVAL_FOR_EXTERNAL_ACTIONS=true
ALLOW_PUBLIC_PUBLISH=false
ALLOW_CUSTOMER_CONTACT=false
ALLOW_PAYMENT_COLLECTION=false
